generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailVerificationPurpose {
  SIGNUP

  FORGOT_USERNAME

  FORGOT_PASSWORD
}

model User {
  id                Int      @id @default(autoincrement())
  publicId          String   @unique @default(uuid())
  firstName         String
  lastName          String
  eMail             String   @unique
  userName          String   @unique
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())

  // Email Verification
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Used for recovery verification:
  // FORGOT_USERNAME / FORGOT_PASSWORD
  emailVerification EmailVerificationToken[]

  // Optional: for security / UX
  // Lockout / backoff
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?

  //MFA (TOTP)
  mfaEnabled    Boolean   @default(false)
  mfaSecretEnc  String?
  mfaEnrolledAt DateTime?

  resetTokens PWResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eMail])
}

model UserPendingSignup {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  userName     String @unique
  eMail        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  expiresAt DateTime

  // Number of times this signup has exhausted
  // the maximum verification attempts
  lockoutCount Int @default(0)

  // Prevents verification/resending until this time
  lockedUntil DateTime?

  emailVerification EmailVerificationToken?
}

model PWResetToken {
  id     String @id @default(uuid())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id String @id @default(uuid())

  // Existing user: FORGOT_USERNAME / FORGOT_PASSWORD

  userId Int?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pending signup: SIGNUP

  pendingSignupId Int?                     @unique
  pendingSignup   UserPendingSignup?       @relation(fields: [pendingSignupId], references: [id], onDelete: Cascade)
  purpose         EmailVerificationPurpose
  codeHash        String
  // Current verification code expiration
  expiresAt       DateTime
  // Normal resend cooldown
  resendAfter     DateTime
  // Attempts against CURRENT code
  attemptCount    Int                      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, purpose])
  @@index([userId])
  @@index([pendingSignupId])
}
